{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Wordsearch puzzle — docs/PUZZLE-FORMAT.md",
  "description": "Shape only. The grid's letters, the title's content and every placement rule are checks 1–10 in core/puzzle-check-core.js, so a failure there names its check.",
  "type": "object",
  "additionalProperties": false,
  "required": ["hiddenId", "collection", "publicId", "title", "wordGroups", "words", "grid"],
  "properties": {
    "hiddenId": { "type": "string", "pattern": "^[A-Z]{4}-[0-9]{4,}$" },
    "collection": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "publicId": { "type": "integer", "minimum": 1 },
    "title": { "type": "string" },
    "wordGroups": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
    },
    "fillPool": { "type": "string", "minLength": 1 },
    "words": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["display", "start", "direction", "length"],
        "properties": {
          "display": { "type": "string", "minLength": 1 },
          "start": {
            "type": "object",
            "additionalProperties": false,
            "required": ["row", "col"],
            "properties": {
              "row": { "type": "integer" },
              "col": { "type": "integer" }
            }
          },
          "direction": { "enum": ["N", "NE", "E", "SE", "S", "SW", "W", "NW"] },
          "length": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "grid": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  }
}
