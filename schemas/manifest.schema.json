{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Collection manifest — docs/PUZZLE-FORMAT.md",
  "description": "Shape only. Agreement with the puzzle files and the public-ID run are checked in core/puzzle-check-core.js.",
  "type": "object",
  "additionalProperties": false,
  "required": ["collection", "name", "puzzles"],
  "properties": {
    "collection": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1 },
    "puzzles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["publicId", "title", "file"],
        "properties": {
          "publicId": { "type": "integer", "minimum": 1 },
          "title": { "type": "string" },
          "file": { "type": "string", "pattern": "^[0-9]{4,}\\.json$" }
        }
      }
    }
  }
}
