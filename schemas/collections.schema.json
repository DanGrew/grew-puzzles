{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Collection index — docs/PUZZLE-FORMAT.md",
  "type": "object",
  "additionalProperties": false,
  "required": ["collections"],
  "properties": {
    "collections": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
    }
  }
}
